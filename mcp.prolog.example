// Copiez ce fichier en mcp.json dans le dossier CSFlow (ou fusionnez le bloc dans votre mcpServers).
//
// Installer prolog-mcp UNE FOIS (aucun téléchargement ensuite : Prolog tourne en local) :
//   git clone https://github.com/adamrybinski/prolog-mcp
//   cd prolog-mcp && npm install && npm run build
//
// Le chemin de « args » est relatif au dossier de CSFlow : le dossier prolog-mcp doit être à côté de app.py
// (sinon, mettez le chemin absolu de prolog-mcp/dist/index.js).
// Les clés « disabled », « alwaysAllow » et « timeout » sont des réglages d'autres clients (Cline, Roo...) :
// CSFlow les ignore (le délai se règle par étape avec « timeout: » dans le YAML).
// « service-public » n'est nécessaire que pour source: fiche.
{
  "mcpServers": {
    "prolog-mcp": {
      "command": "node",
      "args": ["prolog-mcp/dist/index.js"],
      "disabled": false,
      "alwaysAllow": ["loadProgram", "runPrologQuery", "saveSession", "loadSession"],
      "timeout": 15
    },
    "service-public": {
      "url": "https://mcp-service-public.nhaultcoeur.workers.dev/mcp"
    }
  }
}
