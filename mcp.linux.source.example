// Linux/WSL, depuis les sources (app.py a cote de ce fichier) : aucun executable a compiler.
// Prerequis : python3 (3.10 ou plus recent) et PyYAML (sudo apt install python3-yaml).
// CSAgent --mcp-config mcp.json
{
  "mcpServers": {
    "csflow": {
      "command": "python3",
      "args": ["app.py", "--mcp"],
      "cwd": "."
    }
  }
}
